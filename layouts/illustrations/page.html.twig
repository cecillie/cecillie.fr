{% set image = 'images/' ~ page.id ~ '/' ~ page.images[0].file %}

{% extends ['page.html.twig', '_default/page.html.twig'] %}

    {%- block head ~%}
    {{- parent() ~}}
    <style>{% apply minify_css ~%}
      {{ asset('https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css', {minify: false})|inline }}
      :root {
        --swiper-navigation-color: #000;
        --swiper-pagination-color: #000;
      }
    {% endapply ~%}</style>
    {#- structured data: ImageObject ~#}
    {%- set author = {'@type': 'Person', name: site.author, url: url(site.home, {canonical: true})} -%}
    {%- set images_ld = [] -%}
    {%- for img in page.images -%}
      {%- set img_asset = asset('images/' ~ page.id ~ '/' ~ img.file) -%}
      {%- set images_ld = images_ld|merge([{
        '@context': 'https://schema.org',
        '@type': 'ImageObject',
        contentUrl: url(img_asset, {canonical: true}),
        url: url(page, {canonical: true}),
        name: page.title,
        caption: img.alt,
        description: page.description,
        width: img_asset.width,
        height: img_asset.height,
        datePublished: page.date|date('Y-m-d'),
        author: author,
        creator: author,
        creditText: site.author,
        copyrightNotice: '© ' ~ page.date|date('Y') ~ ' ' ~ site.author,
      }]) -%}
    {%- endfor ~%}
    <script type="application/ld+json">
      {{ images_ld|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}
    </script>
    {%- endblock ~%}

      {%- block content ~%}
      <article class="mx-auto max-w-(--breakpoint-md) prose md:prose-lg lg:prose-xl
        prose-img:mx-auto prose-figcaption:text-center prose-img:m-0 prose-picture:m-0 lg:prose-img:mb-1
      ">
        <header class="mb-4">
          <h1>{{ page.title }}</h1>
          {#-<time>{{ page.date|format_date('long') }}</time>~#}
        </header>
        <div class="swiper">
          <div class="swiper-wrapper">
            {%- for img in page.images ~%}
            <div class="swiper-slide">
              {%- set attributes = {alt: img.alt|e, width: 540, class: 'illustration-slide'} -%}
              {%- if loop.index == 1 -%}
                {%- set attributes = attributes|merge({loading: 'eager', fetchpriority: 'high'}) -%}
              {%- else -%}
                {%- set attributes = attributes|merge({loading: 'lazy', decoding: 'async'}) -%}
              {%- endif ~%}
              {{ html(asset('images/' ~ page.id ~ '/' ~ img.file), attributes=attributes) ~}}
            </div>
            {%- endfor ~%}
          </div>
          <div class="swiper-button-next"></div>
          <div class="swiper-button-prev"></div>
          <div class="swiper-pagination"></div>
        </div>
        {{~ page.content ~}}
        {#- Navigation between illustrations ~#}
        {%- if page.prev is defined or page.next is defined ~%}
        <nav class="not-prose my-8 font-light lowercase" aria-label="{% trans %}Navigation entre les illustrations{% endtrans %}">
          <ul class="flex items-center justify-between gap-4">
            <li>
              {%- if page.prev is defined ~%}
              <a class="inline-block no-underline" href="{{ url(page.prev) }}" rel="prev" title="{{ page.prev.title|e('html_attr') }}">← {% trans %}Précédente{% endtrans %}</a>
              {%- endif ~%}
            </li>
            <li>
              {%- if page.next is defined ~%}
              <a class="inline-block no-underline" href="{{ url(page.next) }}" rel="next" title="{{ page.next.title|e('html_attr') }}">{% trans %}Suivante{% endtrans %} →</a>
              {%- endif ~%}
            </li>
          </ul>
        </nav>
        {%- endif ~%}
      </article>
      {%- endblock content ~%}

    {%- block scripts ~%}
    {{- parent() ~}}
    <script>{% apply minify_js ~%}
      {{ asset('https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js', {minify: false})|inline }}
      const swiper = new Swiper('.swiper', {
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        pagination: {
          el: '.swiper-pagination',
        },
      });
    {% endapply ~%}</script>
    {%- endblock ~%}