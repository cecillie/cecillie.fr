<!DOCTYPE html>
<html lang="{{ site.language }}">
  <head>
    {%- block head ~%}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    {{- include('partials/metatags.html.twig') ~}}
    <style>{% apply minify_css ~%}
      /* https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/Heading_Elements#specifying_a_uniform_font_size_for_h1
         https://github.com/GoogleChrome/lighthouse/issues/16404#issuecomment-2754716763 */
      :where(h1) {
        margin-block: 0.67em;
        font-size: 2em;
      }
    {% endapply %}</style>
    {%- if getenv('CECIL_ENV') == 'production' ~%}
    <style>
      {{- asset('css/styles.css', {minify: true})|inline ~}}
    </style>
    {%- else ~%}
    <link rel="stylesheet" href="{{ asset('css/styles.css', {minify: false}) }}">
    {%- endif ~%}
    {%- endblock ~%}
  </head>
  <body class="flex flex-col min-h-screen md:min-h-[calc(100vh-5rem)] font-sans leading-normal tracking-normal md:m-10">
    <header class="w-full container mx-auto p-6">
      <div class="container mx-auto flex flex-wrap items-center">
        <div class="flex w-full md:w-3/4 justify-center md:justify-start font-extrabold">
          {#- logo ~#}
          <a class="no-underline hover:no-underline logo" href="{{ url(site.home) }}">
            <img src="{{ asset('logo.svg') }}" class="w-8" width="75" height="75" alt="{% trans %}Le logo 'C'{% endtrans %}">
          </a>
          {#- email ~#}
          <a class="no-underline hover:no-underline mt-2 ml-10" href="mailto:{{ site.email }}">
            <span class="font-light">{{ site.email }}</span>
          </a>
        </div>
        {#- main menu ~#}
        <nav class="flex w-full md:pt-2 pt-6 content-center justify-between md:w-1/4 md:justify-end">
          <ul class="list-reset flex justify-between flex-1 items-center space-x-4">
          {%- for entry in site.menus.main|sort_by_weight ~%}
            <li>
              <a class="inline-block no-underline hover:no-underline font-light lowercase" href="{{ url(entry.url) }}" rel="noopener" data-weight="{{ entry.weight }}">{{ entry.name }}</a>
            </li>
          {%- endfor ~%}
          </ul>
        </nav>
      </div>
    </header>
    <main class="grow container py-6 md:pt-28 px-6 mx-auto flex-wrap flex-col md:flex-row items-center">
      {#- breadcrumb ~#}
      {%- block breadcrumb ~%}
      {%- if page.type != 'homepage' ~%}
      <nav class="mx-auto max-w-(--breakpoint-md) mb-8 text-sm font-light lowercase" aria-label="{% trans %}Fil d’Ariane{% endtrans %}">
        <ol class="flex flex-wrap items-center gap-2">
          {%- set crumbs = [site.home]|merge(page.ancestors|reverse) ~%}
          {%- for crumb in crumbs ~%}
          <li>
            <a class="no-underline hover:underline" href="{{ url(crumb) }}"><span>{{ crumb == site.home ? 'Accueil'|trans : crumb.title }}</span></a>
          </li>
          <li aria-hidden="true">/</li>
          {%- endfor ~%}
          {%- if page.type == 'section' ~%}
          <li>
            <span aria-current="page">{{ page.title }}</span>
          </li>
          {%- endif ~%}
        </ol>
      </nav>
      {%- endif ~%}
      {%- endblock breadcrumb ~%}
      {#- main content ~#}
      {%- block content ~%}
      <div class="leading-normal mb-4 my-4">
        {{- page.content ~}}
      </div>
      {%- endblock content ~%}
    </main>
    {#- footer ~#}
    {%- block footer ~%}
    <footer class="container mx-auto px-6 py-6 text-right text-sm font-light">
      &copy; {{ 'now'|date('Y') }} {{ site.author }} · {% trans %}Site généré avec{% endtrans %} <a class="underline hover:no-underline" href="{{ cecil.url }}" target="_blank" rel="noopener">Cecil</a>
    </footer>
    {%- endblock footer ~%}
    {#- scripts ~#}
    {%- block scripts %}{% endblock scripts ~%}
    {%- block noise ~%}
    <canvas id="noise" class="noise"></canvas>
    <script src="{{ asset('js/noise.js') }}" async></script>
    {%- endblock noise ~%}
  </body>
</html>