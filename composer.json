{
  "require": {
    "cecil/theme-netlify": "^3.0"
  },
  "require-dev": {
    "aligny/tailwind-builder": "^1.2"
  },
  "scripts": {
    "css:build": "tailwind-builder assets/css/tailwind.css --output=assets/css/styles.css --minify --tailwind-version=v4.3.3",
    "css:watch": "tailwind-builder assets/css/tailwind.css --output=assets/css/styles.css --watch --tailwind-version=v4.3.3"
  },
  "config": {
    "allow-plugins": {
      "cecil/theme-installer": true
    },
    "process-timeout": 0
  }
}
